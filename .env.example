APP_ENV=dev
CORS_ORIGINS=http://localhost:5173
SIM_SEED=42
VISION_MODE=cached            # cached | live
GEMINI_API_KEY=
GEMINI_VISION_MODEL=          # e.g. a current free-tier multimodal Flash model (check AI Studio)
GEMINI_EMBED_MODEL=           # set to a current Gemini embedding model
RAG_MODE=auto                 # auto (vector if key+index, else bm25) | vector | bm25
WEATHER_PROVIDER=noaa          # noaa (US only) | open_meteo (worldwide, no key)
NOAA_ENABLED=true             # live weather on/off (either provider)
OPEN_METEO_LAT=23.8103        # Dhaka
OPEN_METEO_LON=90.4125
OPEN_METEO_LOCATION=Dhaka, BD
NOAA_LAT=40.7128              # store location (NOAA covers US only)
NOAA_LON=-74.0060
NOAA_USER_AGENT=ShelfSense (contact: your-email@example.com)
HTTP_TIMEOUT_S=8
VISION_TIMEOUT_S=60           # live vision call limit; not retried after a timeout

# Accounts: Postgres URL (Neon free tier). Empty = local SQLite file backend/data/local/users.db
DATABASE_URL=
# Signs login tokens. Empty = random per process (sign-ins end on restart). Render generates one.
AUTH_SECRET=
# USERS_DB_PATH=/absolute/path/users.db   (optional; where the SQLite fallback lives)

# Sign-up verification codes by email (Gmail: the address + a Google "app password", which
# needs 2-step verification). Empty in dev = codes are printed to the server log instead;
# empty with APP_ENV=prod = new accounts are paused (sign-in and guests still work).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com   SMTP_PORT=465   (defaults)
